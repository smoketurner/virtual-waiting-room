# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local Kiro tooling settings (per-machine, not project content)
.kiro/settings/

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Lock files ARE committed (pin provider versions per environment):
!**/.terraform.lock.hcl

# Terraform-generated placeholder Lambda zip (archive_file rebuilds it; source
# bootstrap is tracked)
infra/modules/core/placeholder-lambda/placeholder.zip

# Terraform-generated real Lambda artifact zips (archive_file rebuilds them from
# the built bootstrap binaries, which are passed in by path, not committed)
infra/modules/core/.artifacts/

# Lambda bootstraps staged by `make build` (passed to Terraform by path)
/.artifacts/

# Python bytecode cache (scripts/smoke_test.py)
__pycache__/

.claude/settings.local.json

# HAR captures record live session cookies and signed admission policies.
*.har

# macOS Finder metadata.
.DS_Store
