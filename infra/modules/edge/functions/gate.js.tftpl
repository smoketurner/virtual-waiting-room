// The admission gate, at viewer-request on the protected behaviour only
// (issue #71). Decides locally: no backend call, no network access.
//
// Source bytes are a hard deployment limit here (10,240, not adjustable), so
// comments are kept to what stops a specific bug being reintroduced. The
// reasoning lives in docs/adr/0021-edge-function-gate.md.
import cf from 'cloudfront';
import crypto from 'crypto';

var kvs = cf.kvs();
var EVENT_ID = '${event_id}';
var SESSION_COOKIE = '${session_cookie_name}';
var WAITING_PATH = '${waiting_path}';

// The protected behaviour forwards allViewer, so a visitor can send these.
function stripSpoofableHeaders(request) {
    delete request.headers['x-wr-gate'];
    delete request.headers['x-wr-gate-failed'];
}

// No timing-safe compare here: HMAC both digests and compare those.
function macEquals(secret, a, b) {
    var ha = crypto.createHmac('sha256', secret);
    ha.update(a);
    var hb = crypto.createHmac('sha256', secret);
    hb.update(b);
    return ha.digest('base64url') === hb.digest('base64url');
}

// wr_common::crypto derives a key per credential kind, so a token cannot
// validate as a session. This function only ever checks sessions.
function sessionKey(secret) {
    var h = crypto.createHmac('sha256', secret);
    h.update('vwr/jws/session/v1');
    return h.digest();
}

var BASE64URL_RE = /^[A-Za-z0-9_-]+$/;

function decodeJson(segment) {
    try {
        return JSON.parse(Buffer.from(segment, 'base64url').toString('utf8'));
    } catch (e) {
        return null;
    }
}

// Verifies a compact JWS (RFC 7515) and returns its claims. The signature
// covers the ASCII "header.payload".
//
// "alg" is read only to be compared against the one value this deployment
// issues, never to select a verifier, so alg:none and a downgrade are refused.
// Matching the encoded header as a literal string would be smaller but ties
// the gate to the exact field order the Rust side's JWT library emits.
function verify(credential, secret) {
    var parts = credential.split('.');
    if (parts.length !== 3) {
        return null;
    }
    if (!BASE64URL_RE.test(parts[1]) || !BASE64URL_RE.test(parts[2])) {
        return null;
    }
    var header = decodeJson(parts[0]);
    if (!header || header.alg !== 'HS256') {
        return null;
    }

    var mac = crypto.createHmac('sha256', sessionKey(secret));
    mac.update(parts[0] + '.' + parts[1]);
    if (!macEquals(secret, mac.digest('base64url'), parts[2])) {
        return null;
    }

    var claims = decodeJson(parts[1]);
    if (!claims || typeof claims.aud !== 'string' || typeof claims.exp !== 'number') {
        return null;
    }
    return { eventId: claims.aud, expiresAt: claims.exp };
}

// Own-property only: a rule named "constructor" would otherwise be truthy
// with no .value, throwing and passing every request through.
function ownProperty(obj, key) {
    return Object.prototype.hasOwnProperty.call(obj, key) ? obj[key] : undefined;
}

// CloudFront sends the raw path to the origin, so a rule must not be evaded
// by an encoding the origin treats as equivalent. Not a full RFC 3986
// resolver: ".." segments are deliberately not resolved.
function normalizedPath(uri) {
    var decoded = uri;
    try {
        decoded = decodeURIComponent(uri);
    } catch (e) {
        decoded = uri; // malformed percent-encoding: compare the raw URI
    }
    decoded = decoded.replace(/^\/+/, '/').replace(/^\/\.\//, '/');
    return decoded.toLowerCase();
}

function queryString(qs) {
    var parts = [];
    for (var key in qs) {
        if (Object.prototype.hasOwnProperty.call(qs, key) && qs[key] && typeof qs[key].value === 'string') {
            parts.push(encodeURIComponent(key) + '=' + encodeURIComponent(qs[key].value));
        }
    }
    return parts.length ? '?' + parts.join('&') : '';
}

// ["p",prefix] | ["h",name,value] | ["c",name] | ["u",substring]. Mirrors
// wr_common::rules::ProtectionRule::matches; vectors prove they agree.
function matches(rule, request) {
    var headers = request.headers || {};
    var cookies = request.cookies || {};
    if (rule[0] === 'p') {
        return normalizedPath(request.uri).indexOf(rule[1].toLowerCase()) === 0;
    }
    if (rule[0] === 'h') {
        var h = ownProperty(headers, rule[1].toLowerCase());
        return !!h && typeof h.value === 'string' && h.value.toLowerCase() === rule[2].toLowerCase();
    }
    if (rule[0] === 'c') {
        return ownProperty(cookies, rule[1]) !== undefined;
    }
    if (rule[0] === 'u') {
        var ua = ownProperty(headers, 'user-agent');
        return !!ua && typeof ua.value === 'string' && ua.value.indexOf(rule[1]) >= 0;
    }
    return false;
}

function wantsHtml(request) {
    var headers = request.headers || {};
    var mode = headers['sec-fetch-mode'];
    if (mode && mode.value !== 'navigate') {
        return false;
    }
    var accept = headers['accept'];
    return !accept || accept.value.indexOf('text/html') >= 0;
}

// XHR gets 403 JSON (#72), navigation a 302; both carry a reason (#73).
function refuse(request, reason) {
    if (wantsHtml(request)) {
        var destination = request.uri + queryString(request.querystring);
        var next = '&next=' + encodeURIComponent(destination);
        return {
            statusCode: 302,
            statusDescription: 'Found',
            headers: {
                'location': { value: WAITING_PATH + '?r=' + reason + next },
                'cache-control': { value: 'no-store' },
                'x-wr-reason': { value: reason }
            }
        };
    }
    return {
        statusCode: 403,
        statusDescription: 'Forbidden',
        headers: {
            'content-type': { value: 'application/json' },
            'cache-control': { value: 'no-store' },
            'x-wr-reason': { value: reason },
            'x-wr-waiting-room': { value: WAITING_PATH },
            'access-control-expose-headers': { value: 'x-wr-reason,x-wr-waiting-room' }
        },
        body: '{"queued":true,"reason":"' + reason + '","waitingRoom":"' + WAITING_PATH + '"}'
    };
}

async function handler(event) {
    var request = event.request;
    stripSpoofableHeaders(request);
    try {
        // cfg.r === [] is dormancy (#60): every request matches no rule.
        var cfg = await kvs.get('c', { format: 'json' });
        if (cfg.v !== 1) {
            throw new Error('unrecognized gate config version');
        }

        var protectedByRule = false;
        for (var i = 0; i < cfg.r.length; i++) {
            if (matches(cfg.r[i], request)) {
                protectedByRule = true;
                break;
            }
        }
        if (!protectedByRule) {
            return request;
        }

        var now = Math.floor(Date.now() / 1000);

        // enforce_from: one scheduled instant on every edge, not a window.
        if (cfg.s && now < cfg.s) {
            request.headers['x-wr-gate'] = { value: 'pending' };
            return request;
        }
        // fail_open_until: skew can only delay relief, never shorten it.
        if (cfg.f && now < cfg.f) {
            request.headers['x-wr-gate'] = { value: 'failopen' };
            return request;
        }

        var cookie = (request.cookies || {})[SESSION_COOKIE];
        if (!cookie) {
            return refuse(request, 'none');
        }

        var secret = await kvs.get('k', { format: 'string' });
        var session = verify(cookie.value, secret);
        if (!session) {
            return refuse(request, 'signature');
        }
        if (session.eventId !== EVENT_ID) {
            return refuse(request, 'event');
        }
        if (now >= session.expiresAt) {
            return refuse(request, 'expired');
        }
        return request;
    } catch (e) {
        // The gate being broken, not #58: no network calls happen here.
        console.log('gate threw: ' + e);
        request.headers['x-wr-gate-failed'] = { value: 'true' };
        return request;
    }
}
